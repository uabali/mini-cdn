# Placeholder values for running the services outside Docker Compose.
# Each service reads these from its own process environment (no .env loader).

# All services
PORT=8080

# Router
ROUTER_STRATEGY=consistent
HASH_VNODES=100
MAX_INFLIGHT=0
EDGES=http://edge-1:9100,http://edge-2:9100,http://edge-3:9100

# Edge
NODE_NAME=edge-local
ORIGIN_BASE_URL=http://origin:9000
CACHE_ROOT=./cache
CACHE_TTL=5m
CACHE_MAX_BYTES=524288000

# Origin
ORIGIN_ROOT=./files
